---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import { useTranslations } from "../i18n/utils";
import "../styles/global.css";

const { title: _title } = Astro.props;
const t = useTranslations();

const links = [
  { title: "Home", url: "/" },
  { title: "Come funziona", url: "/#come-funziona" },
  { title: "Modelli", url: "/#modelli" },
  { title: "FAQ", url: "/#faq" },
];

const titleSuffix = " | Ecommerce in Revenue Share";
const ogType = "website";
const ogUrl = "https://storerev.com/";
const ogImage = "https://storerev.com/og.png";
const title = `${_title}${titleSuffix}`;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-roboto-slab" preload />
    <Font cssVariable="--font-inter" preload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">{t("accessibility.skip-to-content")}</a>
    <Header
      logoUrl="/"
      logoAlt="StoreRev"
      links={links}
      link1={{ title: "Accedi", url: "#" }}
      link2={{
        title: "Prenota una call",
        url: "#contatti",
      }}
    />
    <main id="main">
      <slot />
    </main>
    <Footer logoUrl="/" logoAlt="StoreRev" links={links} />
    <SmoothScroll />
  </body>
</html>

<style>
  .skip-link {
    background: var(--color-brand-1);
    left: 0;
    right: 0;
    margin: auto;
    width: min-content;
    white-space: nowrap;
    padding: 0.5rem;
    position: absolute;
    transform: translateY(-100%);
    transition: transform 0.3s ease;
    z-index: 100;
  }

  .skip-link:focus {
    transform: translateY(0%);
  }
</style>

<script>
  import "../utils/reveals";
</script>
