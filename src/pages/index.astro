---
import Layout from "../layouts/Layout.astro";
import HeroHome from "../components/HeroHome.astro";
import TextMarquee from "../components/TextMarquee.astro";
import GalleryText from "../components/GalleryText.astro";
import ImageMarquee from "../components/ImageMarquee.astro";
import Faqs from "../components/Faqs.astro";
import StepsTimeline from "../components/StepsTimeline.astro";
import Plans from "../components/Plans.astro";
import Statements from "../components/Statements.astro";
import Introducing from "../components/Introducing.astro";
import RevenueCalculator from "../components/RevenueCalculator.astro";
import ContactCta from "../components/ContactCta.astro";
import GL from "../components/GL.astro";
import GLPlaces from "../components/GlPlaces.astro";

import logo1 from "../assets/logoipsum-344.svg";
import logo2 from "../assets/logoipsum-350.svg";
import logo3 from "../assets/logoipsum-345.svg";
import logo4 from "../assets/logoipsum-385.svg";
import logo5 from "../assets/logoipsum-375.svg";
import logo6 from "../assets/logoipsum-378.svg";
import logo7 from "../assets/logoipsum-346.svg";
import logo8 from "../assets/logoipsum-331.svg";
---

<Layout title="Orixa — Ecommerce in Revenue Share">
  <HeroHome
    title="Creiamo il tuo ecommerce. Investiamo noi."
    subtitle="Costruiamo e gestiamo il tuo store online in revenue share: nessun costo di sviluppo iniziale, guadagniamo solo su quello che vendi."
    cta={{
      title: "Proponi il tuo progetto",
      url: "#contatti",
    }}
  />

  <Introducing
    title="Un ecommerce pronto a vendere. Insieme."
    text="Progettiamo storefront che convertono, cataloghi che crescono e traffico qualificato. UX, performance e checkout pensati per trasformare le visite in ordini, con noi al tuo fianco dall'analisi alla crescita."
    cta={{
      title: "Scopri come funziona",
      url: "#come-funziona",
    }}
  />

  <div id="metodo">
    <StepsTimeline
      title="Il nostro metodo"
      items={[
        {
          title: "Ascolto",
          text: "Partiamo dal tuo business, dal mercato e dagli obiettivi per capire dove vuoi arrivare.",
        },
        {
          title: "Analisi",
          text: "Studiamo opportunità, catalogo e numeri per definire la strategia ecommerce più efficace.",
        },
        {
          title: "Sviluppo",
          text: "Costruiamo e gestiamo il tuo store, pronto a crescere e a vendere.",
        },
        {
          title: "Crescita in revenue share",
          text: "Investiamo noi nello sviluppo e ci remuneriamo con una percentuale sulle vendite: se non vendi, non guadagniamo.",
        },
      ]}
    />
  </div>

  <div id="cosa-costruiamo">
  <GalleryText
    title="Cosa costruiamo"
    text="Storefront che convertono, cataloghi che crescono, traffico qualificato. Design curato, performance elevate e percorsi d'acquisto senza attrito: ogni scelta tecnica è orientata a trasformare i visitatori in clienti."
    cta={{
      title: "Parliamo del tuo progetto",
      url: "#contatti",
    }}
    images={[
      {
        alt: "Homepage di un ecommerce ottimizzata per la conversione",
        src: "/image-1.jpg",
        width: 6000,
        height: 4000,
      },
      {
        alt: "Scheda prodotto con immagini e dettagli",
        src: "/image-2.jpg",
        width: 2689,
        height: 4032,
      },
      {
        alt: "Dashboard con andamento delle vendite online",
        src: "/image-3.jpg",
        width: 3734,
        height: 5359,
      },
    ]}
    marqueeTexts={[
      "Zero costi di setup",
      "Allineati ai tuoi risultati",
      "Solo revenue share",
      "Nessun canone mensile",
    ]}
  />
  </div>

  <Statements
    items={[
      {
        title: "Rischio condiviso",
        text: "Il negozio non spende budget a vuoto: il partner guadagna solo se l'ecommerce cresce e vende.",
      },
      {
        title: "Interessi allineati",
        text: "Entrambe le parti puntano allo stesso obiettivo: aumentare il fatturato del negozio.",
      },
      {
        title: "Accesso a competenze",
        text: "Anche i negozi emergenti possono lavorare con un team ecommerce di alto livello senza investimenti iniziali.",
      },
    ]}
  />

  <TextMarquee
    class="marquee"
    texts={[
      "Zero costi di setup",
      "Allineati ai tuoi risultati",
      "Solo revenue share",
      "Nessun canone mensile",
    ]}
  />

  <RevenueCalculator
    title="Calcola il tuo revenue share"
    text="Muovi lo slider per stimare il compenso mensile in base al fatturato online del tuo negozio."
  />

  <div id="piani">
    <Plans
      title="Il tuo store, il tuo piano"
      subtitle="Tre livelli di supporto, stesso principio: nessun costo di sviluppo iniziale, investiamo noi e guadagniamo insieme a te."
      items={[
        {
          title: "Start",
          price: {
            amount: "79 €/mese",
            duration: "+ 4% sulle vendite",
          },
          link: {
            title: "Richiedi una call",
            url: "#contatti",
          },
          features: [
            { title: "Sviluppo ecommerce incluso" },
            { title: "Hosting e manutenzione" },
            { title: "Setup pagamenti e spedizioni" },
            { title: "Tracking e analytics" },
            { title: "Report mensile sulle performance" },
          ],
        },
        {
          title: "Growth",
          price: {
            amount: "99 €/mese",
            duration: "+ 3% sulle vendite",
          },
          link: {
            title: "Richiedi una call",
            url: "#contatti",
          },
          features: [
            { title: "Tutto del piano Start" },
            { title: "Gestione campagne advertising" },
            { title: "SEO e content marketing" },
            { title: "Email marketing e automazioni" },
          ],
        },
        {
          title: "Managed",
          price: {
            amount: "249 €/mese",
            duration: "+ 2% sulle vendite",
          },
          link: {
            title: "Richiedi una call",
            url: "#contatti",
          },
          features: [
            { title: "Tutto del piano Growth" },
            { title: "Gestione catalogo e merchandising" },
            { title: "Ottimizzazione conversione continua" },
            { title: "Consulenza strategica dedicata" },
          ],
        },
      ]}
    />
  </div>

  <div id="faq">
  <Faqs
    title="Domande frequenti"
    mobileTitle="FAQ"
    subtitle="Le risposte alle domande che ci vengono poste più spesso."
    items={[
      {
        question: "Cosa significa esattamente revenue share?",
        answer:
          "Il nostro compenso è una percentuale delle vendite online del tuo ecommerce. Non ci sono costi di setup, canoni mensili o budget da anticipare.",
      },
      {
        question: "Quanto costa iniziare?",
        answer:
          "Nulla. Sviluppo, design e integrazione tecnica sono a nostro carico. Iniziamo a guadagnare solo quando il negozio genera vendite.",
      },
      {
        question: "Su quale base viene calcolata la percentuale?",
        answer:
          "Sul fatturato netto delle vendite online, al netto di resi, rimborsi e IVA. Percentuale ed esclusioni sono definite in contratto prima dell'inizio.",
      },
      {
        question: "Chi possiede il negozio e i dati?",
        answer:
          "Negozio, dominio, catalogo e dati dei clienti restano di tua proprietà al 100%. Noi operiamo come partner tecnico e di crescita.",
      },
      {
        question: "Che piattaforma utilizzate?",
        answer:
          "Lavoriamo con Shopify, WooCommerce e soluzioni headless, scegliendo la tecnologia più adatta al tuo catalogo e ai tuoi volumi.",
      },
      {
        question: "Esiste un vincolo di durata?",
        answer:
          "Il rapporto è a tempo indeterminato e si interrompe con un preavviso concordato. Restiamo finché generiamo valore misurabile.",
      },
    ]}
  />
  </div>

  <ImageMarquee
    images={[
      {
        src: logo1.src,
        alt: "Logo 1",
      },
      {
        src: logo3.src,
        alt: "Logo 3",
      },
      {
        src: logo4.src,
        alt: "Logo 4",
      },
      {
        src: logo8.src,
        alt: "Logo 8",
      },
      {
        src: logo5.src,
        alt: "Logo 5",
      },
      {
        src: logo6.src,
        alt: "Logo 6",
      },
      {
        src: logo2.src,
        alt: "Logo 2",
      },
      {
        src: logo7.src,
        alt: "Logo 7",
      },
    ]}
  />

  <div id="contatti">
  <ContactCta
    title="Il tuo progetto può diventare un business"
    text="Raccontaci prodotto, mercato e obiettivi. Valutiamo il potenziale e costruiamo insieme un ecommerce in revenue share."
    email="hello@orixa.studio"
  />
  </div>

  <GL />
  <GLPlaces />
</Layout>

<style>
  .marquee {
    padding: 2rem 0;
    z-index: 9;
  }
</style>