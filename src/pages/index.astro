---
import Layout from "../layouts/Layout.astro";
import HeroHome from "../components/HeroHome.astro";
import TextMarquee from "../components/TextMarquee.astro";
import GalleryText from "../components/GalleryText.astro";
import ImageMarquee from "../components/ImageMarquee.astro";
import Faqs from "../components/Faqs.astro";
import StepsTimeline from "../components/StepsTimeline.astro";
import Plans from "../components/Plans.astro";
import Statements from "../components/Statements.astro";
import Introducing from "../components/Introducing.astro";
import RevenueCalculator from "../components/RevenueCalculator.astro";
import ContactCta from "../components/ContactCta.astro";
import GL from "../components/GL.astro";
import GLPlaces from "../components/GlPlaces.astro";

import logo1 from "../assets/logoipsum-344.svg";
import logo2 from "../assets/logoipsum-350.svg";
import logo3 from "../assets/logoipsum-345.svg";
import logo4 from "../assets/logoipsum-385.svg";
import logo5 from "../assets/logoipsum-375.svg";
import logo6 from "../assets/logoipsum-378.svg";
import logo7 from "../assets/logoipsum-346.svg";
import logo8 from "../assets/logoipsum-331.svg";
---

<Layout title="Ecommerce in Revenue Share">
  <HeroHome
    title="Il tuo ecommerce. Zero costi fissi."
    subtitle="Progettiamo, costruiamo e gestiamo il tuo negozio online. Tu paghi solo una percentuale sulle vendite: se non vendi, non ci paghi nulla."
    cta={{
      title: "Prenota una call gratuita",
      url: "#contatti",
    }}
  />

  <Introducing
    title="Cresciamo solo quando cresci tu"
    text="Nessun budget iniziale, nessun canone mensile, nessuna agenzia da anticipare. Investiamo tempo e competenze nello sviluppo del tuo ecommerce e ci remuneriamo con una quota del fatturato online generato. I nostri interessi sono allineati ai tuoi: più vendi, più guadagniamo entrambi."
    cta={{
      title: "Scopri come funziona",
      url: "#come-funziona",
    }}
  />

  <div id="come-funziona">
    <StepsTimeline
      title="Come funziona"
      items={[
        {
          title: "Analisi e strategia",
          text: "Studiamo il tuo prodotto, il mercato e la concorrenza. Definiamo posizionamento, catalogo, prezzi e canali di acquisizione prima di scrivere una riga di codice.",
        },
        {
          title: "Sviluppo dell'ecommerce",
          text: "Realizziamo un negozio veloce, ottimizzato per la conversione e integrato con pagamenti, logistica e strumenti marketing. Tutto a nostro carico.",
        },
        {
          title: "Lancio e crescita",
          text: "Gestiamo campagne, SEO, email e ottimizzazione continua del tasso di conversione. Monitoriamo i risultati e scaliamo ciò che funziona.",
        },
        {
          title: "Compenso a revenue share",
          text: "Fatturiamo solo una percentuale delle vendite online del mese. Nessun costo fisso, nessun vincolo di durata: restiamo finché portiamo risultati.",
        },
      ]}
    />
  </div>

  <GalleryText
    title="Un negozio costruito per vendere, non solo per esistere"
    text="Design curato, performance elevate e percorsi d'acquisto senza attrito. Ogni scelta tecnica è orientata a un unico obiettivo: trasformare i visitatori in clienti."
    cta={{
      title: "Parliamo del tuo progetto",
      url: "#contatti",
    }}
    images={[
      {
        alt: "Homepage di un ecommerce ottimizzata per la conversione",
        src: "/image-1.jpg",
        width: 6000,
        height: 4000,
      },
      {
        alt: "Scheda prodotto con immagini e dettagli",
        src: "/image-2.jpg",
        width: 2689,
        height: 4032,
      },
      {
        alt: "Dashboard con andamento delle vendite online",
        src: "/image-3.jpg",
        width: 3734,
        height: 5359,
      },
    ]}
    marqueeTexts={[
      "Zero costi di setup",
      "Allineati ai tuoi risultati",
      "Solo revenue share",
      "Nessun canone mensile",
    ]}
  />

  <Statements
    items={[
      {
        title: "Rischio zero per te",
        text: "Non anticipi budget per sviluppo, grafica o marketing: l'investimento iniziale è interamente nostro.",
      },
      {
        title: "Interessi allineati",
        text: "Il nostro compenso dipende dal tuo fatturato online. Se il negozio non vende, non guadagniamo.",
      },
      {
        title: "Crescita misurabile",
        text: "Report mensili su vendite, traffico e conversione. Le decisioni si prendono sui dati, non sulle opinioni.",
      },
    ]}
  />

  <TextMarquee
    class="marquee"
    texts={[
      "Zero costi di setup",
      "Allineati ai tuoi risultati",
      "Solo revenue share",
      "Nessun canone mensile",
    ]}
  />

  <RevenueCalculator
    title="Calcola il tuo revenue share"
    text="Muovi lo slider per stimare il compenso mensile in base al fatturato online del tuo negozio."
  />

  <div id="modelli">
    <Plans
      title="Modelli di collaborazione"
      subtitle="Due formule, stesso principio: paghi solo in base a quello che vendiamo insieme."
      items={[
        {
          title: "Launch",
          price: {
            amount: "15%",
            duration: "sulle vendite online",
          },
          link: {
            title: "Richiedi una call",
            url: "#contatti",
          },
          features: [
            { title: "Sviluppo ecommerce incluso" },
            { title: "Setup pagamenti e spedizioni" },
            { title: "Tracking e analytics" },
            { title: "Ottimizzazione conversione continua" },
            { title: "Report mensile sulle performance" },
          ],
        },
        {
          title: "Scale",
          price: {
            amount: "8%",
            duration: "sulle vendite online",
          },
          link: {
            title: "Richiedi una call",
            url: "#contatti",
          },
          features: [
            { title: "Tutto del piano Launch" },
            { title: "Gestione campagne advertising" },
            { title: "SEO e content marketing" },
            { title: "Email marketing e automazioni" },
            { title: "Consulenza strategica dedicata" },
          ],
        },
      ]}
    />
  </div>

  <Faqs
    title="Domande frequenti"
    mobileTitle="FAQ"
    subtitle="Le risposte alle domande che ci vengono poste più spesso."
    items={[
      {
        question: "Cosa significa esattamente revenue share?",
        answer:
          "Significa che il nostro compenso è una percentuale delle vendite online del tuo ecommerce. Non ci sono costi di setup, canoni mensili o budget da anticipare.",
      },
      {
        question: "Su quale base viene calcolata la percentuale?",
        answer:
          "Sul fatturato netto delle vendite online, al netto di resi, rimborsi e IVA. La percentuale e le esclusioni sono definite in contratto prima dell'inizio.",
      },
      {
        question: "Quanto costa iniziare?",
        answer:
          "Nulla. Lo sviluppo, il design e l'integrazione tecnica sono a nostro carico. Iniziamo a guadagnare solo quando il negozio genera vendite.",
      },
      {
        question: "Chi possiede il negozio e i dati?",
        answer:
          "Il negozio, il dominio, il catalogo e i dati dei clienti restano di tua proprietà al 100%. Noi operiamo come partner tecnico e di crescita.",
      },
      {
        question: "Che piattaforma utilizzate?",
        answer:
          "Lavoriamo con Shopify, WooCommerce e soluzioni headless, scegliendo di volta in volta la tecnologia più adatta al tuo catalogo e ai tuoi volumi.",
      },
      {
        question: "Esiste un vincolo di durata?",
        answer:
          "Il rapporto è a tempo indeterminato e si interrompe con un preavviso concordato. Restiamo finché generiamo valore misurabile.",
      },
    ]}
  />

  <ImageMarquee
    images={[
      {
        src: logo1.src,
        alt: "Logo 1",
      },
      {
        src: logo3.src,
        alt: "Logo 3",
      },
      {
        src: logo4.src,
        alt: "Logo 4",
      },
      {
        src: logo8.src,
        alt: "Logo 8",
      },
      {
        src: logo5.src,
        alt: "Logo 5",
      },
      {
        src: logo6.src,
        alt: "Logo 6",
      },
      {
        src: logo2.src,
        alt: "Logo 2",
      },
      {
        src: logo7.src,
        alt: "Logo 7",
      },
    ]}
  />

  <ContactCta
    title="Costruiamo il tuo ecommerce"
    text="Raccontaci il tuo prodotto e i tuoi obiettivi. Valutiamo insieme se il modello revenue share è adatto al tuo business."
    email="hello@storerev.com"
  />

  <GL />
  <GLPlaces />
</Layout>

<style>
  .marquee {
    padding: 2rem 0;
    z-index: 9;
  }
</style>